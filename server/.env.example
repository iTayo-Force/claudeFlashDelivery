# ============================================
# Flash Delivery Server - Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# --- Salesforce ---
SF_LOGIN_URL=https://login.salesforce.com
SF_USERNAME=your-sf-username@example.com
SF_PASSWORD=your-sf-password
SF_SECURITY_TOKEN=your-sf-security-token

# --- JWT ---
JWT_CLIENT_SECRET=generate-a-strong-random-secret-here
JWT_EMPLOYEE_SECRET=generate-a-different-strong-random-secret
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# --- Google ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# --- Apple ---
APPLE_CLIENT_ID=com.claudeflash.delivery

# --- Orange Money ---
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=

# --- MTN MoMo ---
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_CALLBACK_URL=https://your-api-domain.com/api/mobile-money/mtn-momo/webhook

# --- Server ---
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
