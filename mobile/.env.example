# ============================================
# Flash Delivery Mobile - Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# API URL (use your local IP for device testing, not localhost)
EXPO_PUBLIC_API_URL=http://192.168.1.100:3001/api

# WebSocket URL
EXPO_PUBLIC_WS_URL=ws://192.168.1.100:3001/ws

# Google Maps API Key (read by app.config.js for native maps - no need to edit app.json)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Google OAuth Client ID (for expo-auth-session)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
